# Copy this file to .env for local development. Never commit the real .env.
# On Hugging Face Spaces, set GROQ_API_KEY as a Space "Secret" instead —
# the app reads it the same way via os.getenv, no code changes needed.

GROQ_API_KEY= 

# --- Compliance Sentinel agent (agent/) ---
# Default model provider is Bedrock — requires standard AWS credentials
# (env vars, ~/.aws/credentials, or an attached role) with model access
# enabled for the chosen model in your region. No extra env vars needed
# beyond your normal AWS setup unless you want to override the defaults:
# AGENT_MODEL_PROVIDER=bedrock
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS_REGION=us-west-2

# To run the agent without AWS credentials on hand, reuse GROQ_API_KEY above:
AGENT_MODEL_PROVIDER=groq

# Where the agent's persistent cross-run history (filing snapshots,
# findings, memos) is stored:
# AGENT_HISTORY_PATH=data/agent_history.json